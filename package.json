{
  "name": "wumble",
  "version": "1.0.0",
  "description": "A harmonic playing field in the browser",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:relay": "tsc -p tsconfig.relay.json && node -e \"require('fs').renameSync('dist/relay/relay.js', 'dist/relay/relay.mjs')\"",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "npm run build -- --mode e2e && npm run build:relay && playwright test && npm run e2e:coverage",
    "e2e:coverage": "node tools/e2e-coverage.mjs",
    "size": "node tools/size-budget.mjs",
    "single-file": "node tools/single-file.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run size",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-sonarjs": "4.2.1",
    "happy-dom": "20.14.5",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "jsqr": "1.4.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "v8-to-istanbul": "9.3.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
